{
  "name": "BlogPost",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "excerpt": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "cover_image": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Presen\u00e7a digital",
        "Sistemas",
        "Vendas online",
        "SEO",
        "Infraestrutura"
      ],
      "default": "Presen\u00e7a digital"
    },
    "author": {
      "type": "string",
      "default": "Equipe Olivium"
    },
    "read_time": {
      "type": "string"
    },
    "published_date": {
      "type": "string",
      "format": "date"
    },
    "published": {
      "type": "boolean",
      "default": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "title",
    "slug"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
